# =============================================================================
# Video Captioning Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The app will crash at startup if required vars are missing.
# =============================================================================

# --- Required: API Keys & Secrets ---

# Fireworks AI API key (REQUIRED)
# Get yours at https://fireworks.ai/
FIREWORKS_API_KEY=
fw_MEbidJBvXScwCkvcTxhLov
# Comma-separated list of valid X-API-Key values for API auth (REQUIRED)
# At least one key is required for the API to function.
ALLOWED_API_KEYS=dev-key-123,prod-key-456

# Secret key for internal signing (e.g. Celery task signing, session cookies)
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Required: Infrastructure ---

# PostgreSQL connection string (async format)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_captioning

# Redis connection string
# Used for Celery broker + result backend + rate limiting storage
REDIS_URL=redis://localhost:6379/0

# --- Optional: Video Processing ---

# Whisper model size: tiny, base, small, medium, large
# Default: base (fast). Use small/medium for noisy audio.
WHISPER_MODEL=base

# Maximum video download size in MB (videos larger than this are rejected)
MAX_VIDEO_SIZE_MB=200

# Temp directory for video processing artifacts
TEMP_DIR=/tmp/video_captions

# --- Optional: Rate Limiting ---

# Max requests per API key per hour (0 = disabled)
RATE_LIMIT_PER_HOUR=100

# --- Optional: Fireworks AI ---

# Fireworks model ID for caption generation
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p7-plus

# Max tokens for caption generation response
FIREWORKS_MAX_TOKENS=2048
